{
  "name": "ada-pos",
  "version": "3.1.1",
  "description": "ADA Point of Sale System",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win",
    "build-portable": "electron-builder --win --config.win.target=portable",
    "pack": "electron-builder --dir"
  },
  "author": "ADA",
  "license": "PROPRIETARY",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "dependencies": {
    "electron-updater": "^6.1.7",
    "firebase": "^9.23.0"
  },
  "build": {
    "appId": "com.ada.pos",
    "productName": "ADA POS",
    "icon": "src/assets/icon.png",
    "publish": [
      {
        "provider": "github",
        "owner": "alsadiayham-sketch",
        "repo": "ada-pos-releases",
        "releaseType": "release"
      }
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "src/assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ADA POS",
      "installerIcon": "src/assets/icon.ico",
      "uninstallerIcon": "src/assets/icon.ico",
      "installerHeaderIcon": "src/assets/icon.ico",
      "installerSidebar": "src/assets/installer-sidebar.bmp",
      "uninstallerSidebar": "src/assets/uninstaller-sidebar.bmp",
      "installerHeader": "src/assets/installer-header.bmp",
      "artifactName": "ADA-POS-Setup.exe",
      "include": "build/installer.nsh",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": true,
      "displayLanguageSelector": false
    }
  }
}
