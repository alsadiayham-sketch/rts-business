{
  "name": "rts-business",
  "version": "4.0.6",
  "description": "RTS Business by Royal Technology Solutions",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win",
    "build-portable": "electron-builder --win --config.win.target=portable",
    "pack": "electron-builder --dir",
    "publish-update": "node scripts/publish-update.js",
    "release": "npm run build && npm run publish-update"
  },
  "author": "Royal Technology Solutions",
  "license": "PROPRIETARY",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "dependencies": {
    "electron-updater": "^6.1.7",
    "firebase": "^9.23.0"
  },
  "build": {
    "appId": "com.rts.business",
    "productName": "RTS Business",
    "executableName": "RTS Business",
    "icon": "src/assets/icon.png",
    "publish": [
      {
        "provider": "github",
        "owner": "alsadiayham-sketch",
        "repo": "rts-business-releases",
        "releaseType": "release"
      }
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "src/assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "RTS Business",
      "installerIcon": "src/assets/icon.ico",
      "uninstallerIcon": "src/assets/icon.ico",
      "installerHeaderIcon": "src/assets/icon.ico",
      "installerSidebar": "src/assets/installer-sidebar.bmp",
      "uninstallerSidebar": "src/assets/uninstaller-sidebar.bmp",
      "installerHeader": "src/assets/installer-header.bmp",
      "artifactName": "RTS-Business-Setup.exe",
      "include": "build/installer.nsh",
      "runAfterFinish": true,
      "displayLanguageSelector": false
    }
  }
}
