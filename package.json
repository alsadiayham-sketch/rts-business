{
  "name": "rts-business",
  "version": "4.0.13",
  "description": "RTS Business by Royal Technology Solutions",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win",
    "build-portable": "electron-builder --win --config.win.target=portable",
    "pack": "electron-builder --dir",
    "publish-update": "node scripts/publish-update.js",
    "release": "npm run build && npm run publish-update",
    "test": "node --test test/*.test.js",
    "test:restaurant-ui": "node test/electron/run.cjs"
  },
  "author": "Royal Technology Solutions",
  "license": "PROPRIETARY",
  "devDependencies": {
    "electron": "41.10.7",
    "electron-builder": "26.17.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "firebase": "12.10.0",
    "image-size": "2.0.4"
  },
  "build": {
    "appId": "com.rts.business",
    "productName": "RTS Business",
    "executableName": "RTS Business",
    "icon": "src/assets/icon.png",
    "publish": [
      {
        "provider": "github",
        "owner": "alsadiayham-sketch",
        "repo": "rts-business-releases",
        "releaseType": "release"
      }
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "src/assets/icon.png",
      "signtoolOptions": {
        "publisherName": "RTS Royal Technology Solutions"
      }
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "RTS Business",
      "installerIcon": "src/assets/icon.ico",
      "uninstallerIcon": "src/assets/icon.ico",
      "installerHeaderIcon": "src/assets/icon.ico",
      "installerSidebar": "src/assets/installer-sidebar.bmp",
      "uninstallerSidebar": "src/assets/uninstaller-sidebar.bmp",
      "installerHeader": "src/assets/installer-header.bmp",
      "artifactName": "RTS-Business-Setup.exe",
      "include": "build/installer.nsh",
      "runAfterFinish": true,
      "displayLanguageSelector": false
    }
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.5",
    "js-yaml": "4.3.2"
  }
}
