{
  "name": "alaqqad-pos",
  "version": "1.0.0",
  "description": "Aqqad Kids Point of Sale System",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win",
    "pack": "electron-builder --dir"
  },
  "author": "Aqqad",
  "license": "PROPRIETARY",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "dependencies": {
    "firebase": "^9.23.0"
  },
  "build": {
    "appId": "com.aqqad.pos",
    "productName": "Aqqad POS",
    "icon": "src/assets/icon.png",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "portable",
      "icon": "src/assets/icon.png"
    },
    "portable": {
      "artifactName": "Aqqad-POS.exe"
    }
  }
}
